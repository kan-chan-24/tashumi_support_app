<div class="mx-auto md:w-2/3 w-full">
  <h1 class="font-bold text-4xl">ログイン</h1>

  <%= form_with url: session_url, class: "contents" do |form| %>
    <div class="my-5">
      <%= form.text_field :nickname, required: true, autofocus: true, autocomplete: "username", placeholder: "ニックネームを入力", value: params[:nickname], class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
    </div>

    <div class="my-5">
      <%= form.password_field :password, required: true, autocomplete: "current-password", placeholder: "パスワードを入力", maxlength: 72, class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
    </div>

    <div class="col-span-6 sm:flex sm:items-center sm:gap-4">
      <div class="inline">
        <%= form.submit "ログイン", class: "w-full sm:w-auto text-center rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white inline-block font-medium cursor-pointer" %>
      </div>
    </div>
  <% end %>

  <p class="mt-4 text-sm text-gray-500">
    アカウントをお持ちでない方は<%= link_to "新規登録", new_user_path, class: "text-blue-600 underline hover:no-underline" %>
  </p>
</div>
