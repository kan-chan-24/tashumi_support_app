<!-- 7曜日分の入力を一括で入れる箱 -->
<%= form_with url: update_all_free_times_path, method: :patch do |form| %>
  <ul>
    <!-- 7曜日分のループ処理 -->
    <% @free_times.each do |ft|  %>
      <li>
        <!-- 曜日名の表示 -->
        <%= ft.day_name %>
        <!-- 自由時間（分数）の入力欄 -->
        <div class="border-1 mb-2 inline-block">
          <%= number_field_tag "free_times[#{ft.id}][minutes]",ft.minutes %>
        </div>
      </li>
    <% end %>
  </ul>  
  <!-- 送信ボタン(一括更新パスへ）-->
  <div class="border-1 mb-2 inline-block">
    <%= form.submit "更新する" %>
  </div>
<% end %>
