<!-- 7曜日分の表が横に収まるよう、このページだけmainの最大幅を広げる -->
<% content_for :main_width, "max-w-3xl" %>

<h1 class="text-3xl font-bold mb-2 text-ink">なんとなくの週間プランを考えたよ。</h1>
<p>気に入ったプランがあったら選択してね。</p>
<br>
<!-- 入力によってはパターン同士が似た結果になることがあるため、事前に一言添えておく -->
<p class="mb-8 text-xs text-ink-muted">入力内容によって、プランが似ることがあるよ。参考ぐらいに見てみてね。</p>

<!-- すでにスケジュールがお気に入り登録されてるかを確認 -->
<% overwrite_confirm_message = Current.user.saved_schedule.present? ? "スケジュールを上書き登録しますか？" : nil %>
<div class="flex flex-col gap-8">
  <!-- パターン一つずつループする -->
  <% @patterns.each do |pattern_key, pattern_info| %>
    <!-- スケジュール表の材料を取得する -->
    <% schedule_info = schedule_creator(pattern_info[:schedule], @sorted_free_times_by_day) %>
    <!-- ミニバーの基準値。schedule_infoは配分％の高い順に並んでいるため、先頭が最大値 -->
    <% max_percentage = schedule_info.first[:hobby].percentage %>
    <div class="rounded-xl bg-surface p-5 shadow-sm">
      <!-- キャッチフレーズを表示する -->
      <div class="mb-4 flex items-center gap-2">
        <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-accent-dark text-sm font-bold text-white"><%= pattern_key %></span>
        <h2 class="text-lg font-bold text-ink"><%= pattern_info[:catchphrase] %></h2>
      </div>

      <div class="overflow-x-auto rounded-lg bg-base">
        <table class="w-full min-w-[620px] table-fixed border-collapse text-sm">
          <!-- 見出し（趣味名＋7曜日） -->
          <thead>
            <tr class="bg-accent-mid text-white">
              <!-- 趣味名は5文字までを最小幅・最大幅として固定し、超えた分は見えなくする（table-fixedで列幅を固定） -->
              <th class="w-36 px-3 py-2 text-left font-medium">趣味名</th>
              <% @sorted_free_times_by_day.each do |ft| %>
                <!-- 7曜日の曜日名と、その曜日に設定された自由時間を出力 -->
                <th class="px-3 py-2 text-center font-medium">
                  <div class="flex flex-col items-center">
                    <span><%= ft.day_name %></span>
                    <span class="whitespace-nowrap text-xs font-normal opacity-80"><%= free_time_label(ft.minutes) %></span>
                  </div>
                </th>
              <% end %>
            </tr>
          </thead>
          <!-- 表の中身（趣味の値7曜日分） -->
          <tbody>
            <% schedule_info.each_with_index do |info_hash, index| %>
              <tr class="<%= index.even? ? "bg-base" : "bg-accent-light-soft" %> border-b border-border-soft last:border-b-0">
                <!-- 行見出し（趣味名）。一番配分の高い趣味を基準にした相対比率でミニバーを表示し、割合順の並びだと視覚的に伝える -->
                <td class="w-36 px-3 py-2 font-medium text-ink">
                  <div class="flex flex-col gap-1">
                    <div class="flex items-center justify-between gap-2">
                      <span class="truncate"><%= info_hash[:hobby].name %></span>
                      <span class="shrink-0 text-xs font-normal text-ink-muted"><%= info_hash[:hobby].percentage %>%</span>
                    </div>
                    <div class="h-1.5 w-full rounded-full bg-bar-track">
                      <div class="h-1.5 rounded-full bg-accent-dark" style="width: <%= (info_hash[:hobby].percentage.to_f / max_percentage * 100).round(1) %>%;"></div>
                    </div>
                  </div>
                </td>
                <% info_hash[:days].values.each do |day_minutes| %>
                  <!-- 見出し趣味の7曜日分の値（予定なしは薄い色で表示） -->
                  <td class="px-3 py-2 text-center <%= day_minutes == "❌" ? "text-ink-muted" : "text-ink" %>"><%= day_minutes %></td>
                <% end %>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <!-- お気に入り選択ボタン -->
      <%= button_to "これをお気に入りにする", saved_schedule_path, params: { pattern_key: pattern_key, catchphrase: pattern_info[:catchphrase], schedule_data: schedule_data_for_save(schedule_info).to_json }, class: "mt-4 rounded-full bg-accent-mid px-4 py-2 text-sm font-medium text-base hover:bg-accent-dark transition-colors cursor-pointer",data: {turbo_confirm: overwrite_confirm_message} %>
    </div>
  <% end %>
</div>

<!-- 気に入ったものがなければ、趣味登録からやり直せるようにする -->
<div class="mt-8">
  <%= link_to "再診断をする", hobbies_path, class: "inline-block rounded-full bg-accent-light px-4 py-2 text-sm font-medium text-ink hover:bg-accent-mid transition-colors" %>
</div>
