<h1 class="text-xl font-bold mb-4 text-ink">趣味を登録する</h1>

<%= form_with model: @hobby, class: "flex flex-col gap-4" do |form| %>
  <div class="flex flex-col gap-1">
    <%= form.label :name, "趣味の名前", class: "text-sm font-medium text-ink" %>
    <%= form.text_field :name, class: "rounded-lg border border-border-soft bg-base px-3 py-2 text-ink focus:outline-none focus:ring-2 focus:ring-accent-mid" %>
  </div>

  <div class="flex flex-col gap-1">
    <%= form.label :percentage, "趣味の割合（%）", class: "text-sm font-medium text-ink" %>
    <%= form.number_field :percentage, class: "rounded-lg border border-border-soft bg-base px-3 py-2 text-ink focus:outline-none focus:ring-2 focus:ring-accent-mid" %>
  </div>

  <div class="mt-2 flex items-center gap-4">
    <%= form.submit "登録する", class: "rounded-full bg-accent-mid px-4 py-2 text-sm font-medium text-base hover:bg-accent-dark transition-colors cursor-pointer" %>
    <%= link_to "戻る", hobbies_path, class: "text-sm text-ink-muted hover:text-ink" %>
  </div>
<% end %>
