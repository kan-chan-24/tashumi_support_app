<h1 class="text-base font-bold mb-4 text-ink sm:text-xl">趣味を思いつくだけ入れて、<br>それぞれのやりたい度合いを％で教えてね。</h1>

<!-- TOPページへ戻るリンク -->
<div class="mb-4">
  <%= link_to "← TOPへ戻る", root_path, class: "text-sm text-ink-muted hover:text-ink" %>
</div>

<!-- フォーム・削除ボタンからも暫定保存のアクションを呼べるよう、コントローラーの範囲をここまで広げる -->
<div data-controller="hobby-allocator">
  <!-- 趣味の登録フォーム（非同期送信） -->
  <%= render "hobby_form", hobby: @hobby %>

  <!-- Turbo Streamでの差し替え先。常にこのidがページ上に存在する必要がある -->
  <div id="hobby_list">
    <% if @hobbies.empty? %>
      <p class="text-ink-muted">趣味を登録してね</p>
    <% else %>
      <%= render "hobby_list" %>
    <% end %>
  </div>
</div>
